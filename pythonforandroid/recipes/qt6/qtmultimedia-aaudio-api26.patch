+// The AAudio usage, content type and input preset functions are only available since API 28.
+// Resolve them at runtime so that the library can still be loaded on older Android versions.
+template <typename Function>
+Function resolveApi28Function(const char *name)
+{
+    if (QNativeInterface::QAndroidApplication::sdkVersion() < 28)
+        return nullptr;
+
+    auto handle = dlopen("libaaudio.so", RTLD_NOW);
+    Q_ASSERT(handle);
+    auto guard = qScopeGuard([handle] {
+        dlclose(handle);
+    });
+
+    auto function = reinterpret_cast<Function>(dlsym(handle, name));
+    Q_ASSERT(function);
+    return function;
+}
+
